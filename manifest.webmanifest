{
  "name": "表單App",
  "short_name": "表單App",
  "description": "活動報名表單：建立表單、分梯次報名、報名統計與匯出名單",
  "lang": "zh-Hant-TW",
  "id": "/forms-app-web/",
  "start_url": "./",
